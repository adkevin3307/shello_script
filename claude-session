#!/bin/bash

SELF="$(realpath "${BASH_SOURCE[0]}")"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
PROJECTS_DIR="${CLAUDE_DIR}/projects"

function HELP() {
    echo -e "Manage Claude Code sessions."
    echo -e ""
    echo -e "\033[93mUSAGE:\033[0m"
    echo -e "    claude-session <COMMAND> [OPTIONS] [ARGS]"
    echo -e ""
    echo -e "\033[93mCOMMANDS:\033[0m"
    echo -e "    \033[92mlist, ls [--here] [--limit <N>]\033[0m"
    echo -e "    \tList sessions, newest first. --here only shows sessions started in the current directory."
    echo -e "    \033[92mshow [ID]\033[0m"
    echo -e "    \tShow session metadata and its conversation (user prompts and assistant text)."
    echo -e "    \033[92mcreate, new [--name <NAME>] [--dir <DIR>] [-- CLAUDE OPTIONS]\033[0m"
    echo -e "    \tStart a new session with a fresh session id."
    echo -e "    \033[92mresume [ID] [-- CLAUDE OPTIONS]\033[0m"
    echo -e "    \tResume a session in the directory it was started in."
    echo -e "    \033[92mfork [ID] [-- CLAUDE OPTIONS]\033[0m"
    echo -e "    \tResume a session as a new copy (new session id)."
    echo -e "    \033[92mrename [ID] <NAME>\033[0m"
    echo -e "    \tSet the session title."
    echo -e "    \033[92mdelete, rm [-y] [--history] [ID...]\033[0m"
    echo -e "    \tDelete sessions and their side data. -y skips confirmation,"
    echo -e "    \t--history also removes their entries from the prompt history."
    echo -e ""
    echo -e "    ID may be a unique prefix of the session id. If ID is omitted, pick one with fzf."
    echo -e ""
    echo -e "\033[93mOPTIONS:\033[0m"
    echo -e "    \033[92m-h, --help\033[0m"
    echo -e "    \tPrint this help message."
}

function ERROR() {
    echo -e "\033[91m$*\033[0m" >&2
}

function require() {
    for CMD in "$@"; do
        if ! command -v "${CMD}" > /dev/null; then
            ERROR "Command ${CMD} not found."

            exit 1
        fi
    done
}

# All session files, newest first.
function session_files() {
    find "${PROJECTS_DIR}" -mindepth 2 -maxdepth 2 -name '*.jsonl' -printf '%T@ %p\n' 2> /dev/null |
        sort -rn |
        cut -d' ' -f2-
}

function session_cwd() {
    grep -m1 '"cwd":' "$1" | jq -r '.cwd // empty'
}

function session_title() {
    local FILE="$1"
    local ID
    ID="$(basename "${FILE}" .jsonl)"
    local TITLE=""

    if [[ -f "${FILE%.jsonl}/custom-title.json" ]]; then
        TITLE="$(jq -r '.customTitle // empty' "${FILE%.jsonl}/custom-title.json")"
    fi

    if [[ -z "${TITLE}" ]]; then
        TITLE="$(grep '"type":"custom-title"' "${FILE}" | tail -n1 | jq -r '.customTitle // empty')"
    fi

    if [[ -z "${TITLE}" ]]; then
        TITLE="$(grep '"type":"ai-title"' "${FILE}" | tail -n1 | jq -r '.aiTitle // empty')"
    fi

    if [[ -z "${TITLE}" ]]; then
        TITLE="$(grep '"type":"user"' "${FILE}" |
            jq -r 'select(.message.content | type == "string" and (startswith("<") | not)) | .message.content | gsub("\\s+"; " ") | .[0:60]' 2> /dev/null |
            head -n1)"
    fi

    # tabs and newlines would break the rows of list and picker
    TITLE="${TITLE//[$'\t\n']/ }"

    echo "${TITLE:-(untitled)}"
}

function session_prompts() {
    grep '"type":"user"' "$1" | jq -r 'select(.message.content | type == "string" and (startswith("<") | not)) | 1' 2> /dev/null | wc -l
}

# Print "<session id> <pid>" for every live Claude process.
function live_sessions() {
    local PID_FILE ID PID START

    for PID_FILE in "${CLAUDE_DIR}"/sessions/*.json; do
        [[ -f "${PID_FILE}" ]] || continue

        read -r ID PID START < <(jq -r '"\(.sessionId) \(.pid) \(.procStart // "")"' "${PID_FILE}" 2> /dev/null)

        [[ -n "${PID}" ]] && kill -0 "${PID}" 2> /dev/null || continue

        # Guard against a reused pid.
        if [[ -n "${START}" && -r "/proc/${PID}/stat" && "$(awk '{print $22}' "/proc/${PID}/stat")" != "${START}" ]]; then
            continue
        fi

        echo "${ID} ${PID}"
    done
}

# Print the pid of the live process using the session, if any.
function session_pid() {
    live_sessions | awk -v id="$1" '$1 == id { print $2; found = 1; exit } END { exit !found }'
}

# Print one row per session, newest first, fields separated by \x1f:
# id, mtime, prompts, running (0/1), directory, title.
function session_rows() {
    local HERE="$1"
    local RUNNING FILE

    RUNNING=" $(live_sessions | cut -d' ' -f1 | tr '\n' ' ')"

    while read -r FILE; do
        local ID CWD RUN=0
        ID="$(basename "${FILE}" .jsonl)"
        CWD="$(session_cwd "${FILE}")"

        if [[ ${HERE} == 1 && "${CWD}" != "${PWD}" ]]; then
            continue
        fi

        if [[ "${RUNNING}" == *" ${ID} "* ]]; then
            RUN=1
        fi

        printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
            "${ID}" \
            "$(stat -c %Y "${FILE}")" \
            "$(session_prompts "${FILE}")" \
            "${RUN}" \
            "${CWD}" \
            "$(session_title "${FILE}")"
    done < <(session_files)
}

# Columns the text takes in the terminal, wide characters take 2.
function display_width() {
    if [[ "$1" != *[![:ascii:]]* ]]; then
        echo "${#1}"
    else
        printf '%s' "$1" | wc -L
    fi
}

# Truncate TEXT to WIDTH columns with "...", then pad it with spaces to WIDTH.
function fit() {
    local WIDTH="$1" TEXT="$2" LENGTH

    LENGTH="$(display_width "${TEXT}")"

    if [[ ${LENGTH} -gt ${WIDTH} ]]; then
        TEXT="${TEXT:0:$((WIDTH - 3))}"
        LENGTH="$(display_width "${TEXT}")"

        while [[ ${LENGTH} -gt $((WIDTH - 3)) ]]; do
            TEXT="${TEXT:0:-1}"
            LENGTH="$(display_width "${TEXT}")"
        done

        TEXT+="..."
        LENGTH=$((LENGTH + 3))
    fi

    printf '%s%*s' "${TEXT}" $((WIDTH - LENGTH)) ''
}

# Print picker rows "<id>\t<line>", the line fits in WIDTH columns like `ls -l` in telescope file browser:
# running mark, title, project, prompts and modified time (year instead of time when older than six months).
function picker_rows() {
    local WIDTH="$1"
    local GREEN=$'\033[92m' BLUE=$'\033[94m' RESET=$'\033[0m'
    local IDS=() MTIMES=() PROMPTS=() RUNS=() PROJECTS=() TITLES=()
    local ID MTIME PROMPT RUN CWD TITLE PROJECT

    while IFS=$'\x1f' read -r ID MTIME PROMPT RUN CWD TITLE; do
        IDS+=("${ID}")
        MTIMES+=("${MTIME}")
        PROMPTS+=("${PROMPT}")
        RUNS+=("${RUN}")
        PROJECT="${CWD##*/}"
        PROJECTS+=("${PROJECT:-${CWD:-?}}")
        TITLES+=("${TITLE}")
    done < <(session_rows 0)

    # width of project (at most 16) and prompts columns
    local PROJECT_WIDTH=0 PROMPT_WIDTH=1 I

    for I in "${!IDS[@]}"; do
        local LENGTH
        LENGTH="$(display_width "${PROJECTS[I]}")"

        if [[ ${LENGTH} -gt ${PROJECT_WIDTH} ]]; then
            PROJECT_WIDTH=${LENGTH}
        fi

        if [[ ${#PROMPTS[I]} -gt ${PROMPT_WIDTH} ]]; then
            PROMPT_WIDTH=${#PROMPTS[I]}
        fi
    done

    if [[ ${PROJECT_WIDTH} -gt 16 ]]; then
        PROJECT_WIDTH=16
    fi

    # mark 1, time 12 and 4 separators take 17 columns, drop the project column (and its separator) when the title gets too short
    local TITLE_WIDTH=$((WIDTH - 17 - PROMPT_WIDTH - PROJECT_WIDTH))

    if [[ ${TITLE_WIDTH} -lt 12 ]]; then
        PROJECT_WIDTH=0
        TITLE_WIDTH=$((WIDTH - 16 - PROMPT_WIDTH))
    fi

    if [[ ${TITLE_WIDTH} -lt 4 ]]; then
        TITLE_WIDTH=4
    fi

    local NOW
    printf -v NOW '%(%s)T' -1

    for I in "${!IDS[@]}"; do
        local MARK=" " TIME
        PROJECT=""

        if [[ ${RUNS[I]} == 1 ]]; then
            MARK="●"
        fi

        if [[ ${PROJECT_WIDTH} -gt 0 ]]; then
            PROJECT=" ${GREEN}$(fit "${PROJECT_WIDTH}" "${PROJECTS[I]}")${RESET}"
        fi

        if [[ $((NOW - MTIMES[I])) -lt 15768000 ]]; then
            printf -v TIME '%(%b %e %H:%M)T' "${MTIMES[I]}"
        else
            printf -v TIME '%(%b %e  %Y)T' "${MTIMES[I]}"
        fi

        printf '%s\t%s %s%s %s%*s %s%s\n' \
            "${IDS[I]}" \
            "${GREEN}${MARK}${RESET}" \
            "${BLUE}$(fit "${TITLE_WIDTH}" "${TITLES[I]}")${RESET}" \
            "${PROJECT}" \
            "${BLUE}" "${PROMPT_WIDTH}" "${PROMPTS[I]}" \
            "${TIME}" "${RESET}"
    done
}

# Pick a session with fzf and print its id. In "delete" mode (inside tmux only), Enter asks for confirmation
# in a popup on top of the picker, the picker goes on when the answer is no.
function pick_session() {
    require fzf

    local MODE="$1"
    local BINDS=()

    if [[ ${MODE} == delete ]]; then
        # show on the list border why a running session can not be deleted, until the cursor moves
        BINDS=(
            --bind "enter:transform(\"${SELF}\" __confirm-delete {1} 2> /dev/null)"
            --bind 'focus:change-list-label( Sessions )'
        )
    fi

    # popup width and preview width in percentage, the row layout of picker_rows depends on them
    local POPUP=80 PREVIEW=50
    local TOTAL

    if [[ -n "${TMUX}" ]]; then
        # --tmux opens a popup of the window size, its border and fzf margin take 4 columns
        TOTAL=$(($(tmux display-message -p '#{window_width}') * POPUP / 100 - 4))
    else
        # fzf takes the whole terminal outside tmux
        TOTAL="$(stty size < /dev/tty 2> /dev/null | cut -d' ' -f2)"
        TOTAL="${TOTAL:-80}"
    fi

    # list border, padding, pointer and gutter take 7 columns, 1 more for rounding of the preview width
    local WIDTH=$((TOTAL - TOTAL * PREVIEW / 100 - 8))

    # same layout as telescope: results above prompt on the left, preview on the right
    picker_rows "${WIDTH}" | fzf \
        --tmux "${POPUP}%,90%" \
        --no-bold \
        --no-sort \
        --ansi \
        --cycle \
        --delimiter '\t' \
        --with-nth 2 \
        --accept-nth 1 \
        --prompt '> ' \
        --pointer '>' \
        --gutter ' ' \
        --info inline-right \
        --list-border rounded \
        --list-label ' Sessions ' \
        --input-border rounded \
        --input-label ' claude-session ' \
        --preview-label ' Preview ' \
        --preview-window "right:${PREVIEW}%:wrap" \
        --preview "\"${SELF}\" show {1}" \
        --bind 'tab:down,shift-tab:up' \
        --bind 'ctrl-j:preview-half-page-down,ctrl-k:preview-half-page-up' \
        "${BINDS[@]}"
}

# Resolve an id (or prefix) to its jsonl file. Picks interactively when empty.
function resolve_session() {
    local ID="$1"

    if [[ -z "${ID}" ]]; then
        ID="$(pick_session)" || exit 1
    fi

    local MATCHES=()
    mapfile -t MATCHES < <(find "${PROJECTS_DIR}" -mindepth 2 -maxdepth 2 -name "${ID}*.jsonl" 2> /dev/null)

    if [[ ${#MATCHES[@]} -eq 0 ]]; then
        ERROR "Session ${ID} not found."

        exit 1
    fi

    if [[ ${#MATCHES[@]} -gt 1 ]]; then
        ERROR "Session id ${ID} is ambiguous:"

        for MATCH in "${MATCHES[@]}"; do
            basename "${MATCH}" .jsonl >&2
        done

        exit 1
    fi

    echo "${MATCHES[0]}"
}

function cmd_list() {
    local HERE=0
    local LIMIT=0

    while [[ $# -gt 0 ]]; do
        case $1 in
        --here)
            HERE=1

            shift
            ;;
        -n | --limit)
            LIMIT=$2

            shift
            shift
            ;;
        *)
            ERROR "Option $1 not found."

            exit 1
            ;;
        esac
    done

    local COUNT=0
    local ID MTIME PROMPT RUN CWD TITLE

    printf '%-36s  %-16s  %5s  %-3s  %-40s  %s\n' "ID" "MODIFIED" "MSGS" "RUN" "DIRECTORY" "TITLE"

    while IFS=$'\x1f' read -r ID MTIME PROMPT RUN CWD TITLE; do
        if [[ ${RUN} == 1 ]]; then
            RUN="*"
        else
            RUN=""
        fi

        printf '%-36s  %(%Y-%m-%d %H:%M)T  %5s  %-3s  %-40s  %s\n' \
            "${ID}" \
            "${MTIME}" \
            "${PROMPT}" \
            "${RUN}" \
            "${CWD/#${HOME}/\~}" \
            "${TITLE}"

        COUNT=$((COUNT + 1))

        if [[ ${LIMIT} -gt 0 && ${COUNT} -ge ${LIMIT} ]]; then
            break
        fi
    done < <(session_rows "${HERE}")
}

function cmd_show() {
    local FILE ID PID
    FILE="$(resolve_session "$1")" || exit 1
    ID="$(basename "${FILE}" .jsonl)"

    echo -e "\033[93mID:\033[0m        ${ID}"
    echo -e "\033[93mTitle:\033[0m     $(session_title "${FILE}")"
    echo -e "\033[93mDirectory:\033[0m $(session_cwd "${FILE}")"
    echo -e "\033[93mBranch:\033[0m    $(grep -m1 '"gitBranch":' "${FILE}" | jq -r '.gitBranch // empty')"
    echo -e "\033[93mStarted:\033[0m   $(grep -m1 '"type":"user"' "${FILE}" | jq -r '.timestamp // empty')"
    echo -e "\033[93mModified:\033[0m  $(date -d "@$(stat -c %Y "${FILE}")" '+%Y-%m-%d %H:%M:%S')"
    echo -e "\033[93mPrompts:\033[0m   $(session_prompts "${FILE}")"
    echo -e "\033[93mSize:\033[0m      $(du -sh "${FILE}" | cut -f1)"
    echo -e "\033[93mFile:\033[0m      ${FILE}"

    if PID="$(session_pid "${ID}")"; then
        echo -e "\033[93mRunning:\033[0m   pid ${PID}"
    fi

    echo ""

    jq -r '
        if .type == "user" and (.message.content | type == "string") then
            "\u001b[92m> " + .message.content + "\u001b[0m\n"
        elif .type == "assistant" then
            ([.message.content[]? | select(.type == "text") | .text] | join("\n")) as $text
            | if $text == "" then empty else $text + "\n" end
        else
            empty
        end
    ' "${FILE}" 2> /dev/null
}

function cmd_create() {
    local NAME=""
    local DIR="${PWD}"

    while [[ $# -gt 0 && ! "$1" == "--" ]]; do
        case $1 in
        -n | --name)
            NAME=$2

            shift
            shift
            ;;
        -d | --dir)
            DIR=$2

            shift
            shift
            ;;
        *)
            ERROR "Option $1 not found."

            exit 1
            ;;
        esac
    done

    if [[ "$1" == "--" ]]; then
        shift
    fi

    local ID ARGS
    ID="$(cat /proc/sys/kernel/random/uuid 2> /dev/null || uuidgen)"
    ARGS=(--session-id "${ID}")

    if [[ -n "${NAME}" ]]; then
        ARGS+=(--name "${NAME}")
    fi

    cd "${DIR}" || exit 1

    echo "Creating session ${ID} in ${PWD} ..."

    exec claude "${ARGS[@]}" "$@"
}

function cmd_resume() {
    local FORK="$1"
    shift

    local ID=""

    if [[ $# -gt 0 && ! "$1" == "--" ]]; then
        ID=$1

        shift
    fi

    if [[ "$1" == "--" ]]; then
        shift
    fi

    local FILE CWD
    FILE="$(resolve_session "${ID}")" || exit 1
    ID="$(basename "${FILE}" .jsonl)"
    CWD="$(session_cwd "${FILE}")"

    if [[ -n "${CWD}" && -d "${CWD}" ]]; then
        cd "${CWD}" || exit 1
    elif [[ -n "${CWD}" ]]; then
        ERROR "Directory ${CWD} no longer exists, resuming from ${PWD}."
    fi

    if [[ ${FORK} == 1 ]]; then
        exec claude --resume "${ID}" --fork-session "$@"
    fi

    exec claude --resume "${ID}" "$@"
}

function cmd_rename() {
    local ID="" NAME=""

    if [[ $# -ge 2 ]]; then
        ID=$1
        NAME=$2
    else
        NAME=$1
    fi

    if [[ -z "${NAME}" ]]; then
        ERROR "Missing <NAME>."

        exit 1
    fi

    local FILE
    FILE="$(resolve_session "${ID}")" || exit 1
    ID="$(basename "${FILE}" .jsonl)"

    if session_pid "${ID}" > /dev/null; then
        ERROR "Session ${ID} is running; it may overwrite the new title. Use /rename inside it instead."
    fi

    mkdir -p "${FILE%.jsonl}"
    jq -nc --arg t "${NAME}" '{customTitle: $t}' > "${FILE%.jsonl}/custom-title.json"
    jq -nc --arg t "${NAME}" --arg id "${ID}" '{type: "custom-title", customTitle: $t, sessionId: $id}' >> "${FILE}"

    echo "Renamed ${ID} to \"${NAME}\"."
}

# Ask whether to delete the session files, in a popup inside tmux. Return 0 when the answer is yes.
function confirm_delete() {
    local FILES=("$@")
    local HEADER="Delete the following sessions?"$'\n'
    local WIDTH=40
    local FILE

    for FILE in "${FILES[@]}"; do
        local TITLE LINE LENGTH
        TITLE="$(session_title "${FILE}")"

        if [[ "$(display_width "${TITLE}")" -gt 60 ]]; then
            TITLE="$(fit 60 "${TITLE}")"
        fi

        LINE="  $(basename "${FILE}" .jsonl | cut -c1-8)  ${TITLE}"
        LENGTH="$(display_width "${LINE}")"
        HEADER+=$'\n'"${LINE}"

        if [[ $((LENGTH + 12)) -gt ${WIDTH} ]]; then
            WIDTH=$((LENGTH + 12))
        fi
    done

    local ANSWER

    if command -v fzf > /dev/null; then
        # height: popup border 2 + fzf border 2 + header (question, blank, sessions) + separator 1 + 2 options
        ANSWER="$(
            printf 'No\nYes\n' | fzf \
                --tmux "${WIDTH},$((${#FILES[@]} + 9))" \
                --no-bold \
                --no-sort \
                --ansi \
                --border-label ' claude-session ' \
                --layout reverse \
                --no-input \
                --no-info \
                --header "${HEADER}" \
                --header-border line \
                --pointer '▶' \
                --gutter ' ' \
                --bind 'tab:down,shift-tab:up' \
                --bind 'y:pos(2)+accept,n:pos(1)+accept'
        )"
    else
        echo "${HEADER}"
        read -r -p "Continue? [y/N] " ANSWER
    fi

    [[ "${ANSWER}" =~ ^([Yy]|Yes)$ ]]
}

# Run by Enter of the picker in delete mode: confirm on top of the picker and print the fzf action for the answer.
function cmd_confirm_delete() {
    local FILE ID

    # nothing is focused when the list is empty
    [[ -n "$1" ]] || exit 0

    FILE="$(resolve_session "$1")" || exit 0
    ID="$(basename "${FILE}" .jsonl)"

    if session_pid "${ID}" > /dev/null; then
        echo "change-list-label( Session ${ID:0:8} is running, close it first )"
    elif confirm_delete "${FILE}"; then
        echo "accept"
    fi
}

function cmd_delete() {
    local YES=0
    local HISTORY=0
    local IDS=()

    while [[ $# -gt 0 ]]; do
        case $1 in
        -y | --yes)
            YES=1

            shift
            ;;
        --history)
            HISTORY=1

            shift
            ;;
        -*)
            ERROR "Option $1 not found."

            exit 1
            ;;
        *)
            IDS+=("$1")

            shift
            ;;
        esac
    done

    if [[ ${#IDS[@]} -eq 0 ]]; then
        local MODE="" PICKED

        # inside tmux the picker asks for confirmation on top of itself
        if [[ ${YES} == 0 && -n "${TMUX}" ]]; then
            MODE="delete"
        fi

        PICKED="$(pick_session "${MODE}")" || exit 1
        IDS=("${PICKED}")

        if [[ ${MODE} == delete ]]; then
            YES=1
        fi
    fi

    local FILES=()

    for ID in "${IDS[@]}"; do
        local FILE
        FILE="$(resolve_session "${ID}")" || exit 1
        ID="$(basename "${FILE}" .jsonl)"

        if session_pid "${ID}" > /dev/null; then
            ERROR "Session ${ID} is running, skip it."

            continue
        fi

        FILES+=("${FILE}")
    done

    [[ ${#FILES[@]} -gt 0 ]] || exit 1

    if [[ ${YES} == 0 ]]; then
        confirm_delete "${FILES[@]}" || exit 1
    fi

    for FILE in "${FILES[@]}"; do
        local ID
        ID="$(basename "${FILE}" .jsonl)"

        rm -rf -- "${FILE}" "${FILE%.jsonl}" \
            "${CLAUDE_DIR}/file-history/${ID}" \
            "${CLAUDE_DIR}/session-env/${ID}"
        rm -f -- "${CLAUDE_DIR}"/todos/"${ID}"*.json

        if [[ ${HISTORY} == 1 && -f "${CLAUDE_DIR}/history.jsonl" ]]; then
            local TMP
            TMP="$(mktemp "${CLAUDE_DIR}/history.jsonl.XXXXXX")"

            jq -c --arg id "${ID}" 'select(.sessionId != $id)' "${CLAUDE_DIR}/history.jsonl" > "${TMP}" &&
                mv -- "${TMP}" "${CLAUDE_DIR}/history.jsonl"
        fi

        echo "Deleted ${ID}."
    done
}

require jq

COMMAND="$1"
shift

case ${COMMAND} in
list | ls)
    cmd_list "$@"
    ;;
show | cat)
    cmd_show "$@"
    ;;
create | new)
    require claude
    cmd_create "$@"
    ;;
resume)
    require claude
    cmd_resume 0 "$@"
    ;;
fork)
    require claude
    cmd_resume 1 "$@"
    ;;
rename | mv)
    cmd_rename "$@"
    ;;
delete | rm)
    cmd_delete "$@"
    ;;
__confirm-delete)
    # internal, run by the picker of delete
    cmd_confirm_delete "$@"
    ;;
"" | -h | --help | help)
    HELP
    ;;
*)
    ERROR "Command ${COMMAND} not found."
    echo -e "Please check [-h|--help] for more details."

    exit 1
    ;;
esac
